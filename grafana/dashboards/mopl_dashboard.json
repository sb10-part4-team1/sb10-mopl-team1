      "id": 100,
      "title": "Row 1: 배치 잡 실행 상태 (Batch Job Status)",
      "type": "row"
    },
    {
      "title": "TMDB Job Status",
      "type": "stat",
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "expr": "mopl_batch_job_status{jobName=\"tmdbJob\"}",
          "refId": "A",
          "legendFormat": "{{jobName}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "성공 (COMPLETED)", "color": "green" },
                "0": { "text": "실패 (FAILED)", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Sports Job Status",
      "type": "stat",
      "id": 2,

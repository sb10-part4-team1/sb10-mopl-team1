        },
        {
          "expr": "sum(increase(mopl_api_call_duration_seconds_sum{client=\"tmdb\"}[24h])) / sum(increase(mopl_api_call_duration_seconds_count{client=\"tmdb\"}[24h]))",
          "refId": "B",
          "legendFormat": "평균 응답 속도"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
